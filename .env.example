# PostgreSQL Connection String (Matches docker-compose.yml)
DATABASE_URL=postgresql://campus_admin:campus_secure_password@localhost:5432/smart_lost_and_found

# Embedding Model Configuration
# 'local' uses @xenova/transformers (all-MiniLM-L6-v2) without any paid API key
EMBEDDING_PROVIDER=local

# Optional: If you prefer OpenAI embeddings, set EMBEDDING_PROVIDER=openai and supply key
OPENAI_API_KEY=

# Node Environment
NODE_ENV=development
